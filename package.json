{
  "name": "tictic",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "prepare": "husky",
    "lint": "cd server && pnpm run lint && cd ../web && pnpm run lint && cd ../e2e && pnpm run lint",
    "lint:fix": "cd server && pnpm run lint:fix && cd ../web && pnpm run lint && cd ../e2e && pnpm run lint:fix"
  },
  "devDependencies": {
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0"
  },
  "lint-staged": {
    "server/src/**/*.ts": [
      "cd server && pnpm exec eslint --fix --cache --no-warn-ignored .",
      "cd server && pnpm exec tsc --noEmit"
    ],
    "web/**/*.{ts,tsx}": [
      "cd web && pnpm exec eslint --fix --cache --no-warn-ignored ."
    ],
    "e2e/**/*.ts": [
      "cd e2e && pnpm exec eslint --fix --cache --no-warn-ignored ."
    ]
  }
}
