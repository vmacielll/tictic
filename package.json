{
  "name": "ticktick-clone",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "e2e": "turbo e2e --filter=@ticktick/e2e",
    "e2e:ui": "turbo e2e:ui --filter=@ticktick/e2e",
    "e2e:headed": "turbo e2e:headed --filter=@ticktick/e2e",
    "db:migrate": "npx prisma migrate dev --schema=apps/server/src/infra/database/prisma/schema.prisma",
    "db:studio": "npx prisma studio --schema=apps/server/src/infra/database/prisma/schema.prisma"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "npm@10.0.0",
  "optionalDependencies": {
    "@esbuild/darwin-arm64": "^0.28.0"
  }
}
